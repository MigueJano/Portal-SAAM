# Copiar como .env solo para desarrollo local.
# En producción usar variables del WSGI/servidor y credenciales diferentes.

# Django
DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=0

# Gmail saliente (usar una clave de aplicación, nunca la contraseña normal)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=1
EMAIL_SMTP_USER=contabilidad@empresa.cl
EMAIL_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=contabilidad@empresa.cl

# Gmail entrante
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=contabilidad@empresa.cl
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX

# Banco de Chile - completar solo con datos entregados durante homologación
BANCO_CHILE_MOVIMIENTOS_URL=
BANCO_CHILE_CLIENT_ID=
BANCO_CHILE_CLIENT_SECRET=
BANCO_CHILE_BEARER_TOKEN=
BANCO_CHILE_RUT_ORIGEN=
BANCO_CHILE_PRODUCTO_CUENTA=CTD
BANCO_CHILE_CUENTA=
BANCO_CHILE_RUT_APODERADO=
