# Django
# Genere una clave unica y privada para cada ambiente; siempre es obligatoria.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Lista separada por comas, sin http:// ni rutas.
# Ejemplo: DJANGO_ALLOWED_HOSTS=tuusuario.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# Banco de Chile - Sandbox
BANCO_CHILE_AMBIENTE=sandbox
BANCO_CHILE_MOVIMIENTOS_URL=https://gw.apistore.bancochile.cl/banco-chile/sandbox/v1/movimientos-cuenta
BANCO_CHILE_CLIENT_ID=
BANCO_CHILE_CLIENT_SECRET=
# Sandbox puede exigir un Bearer asignado por APIstore. No use el token de ejemplo.
BANCO_CHILE_BEARER_TOKEN=
BANCO_CHILE_RUT_ORIGEN=
BANCO_CHILE_PRODUCTO_CUENTA=CTD
BANCO_CHILE_CUENTA=
BANCO_CHILE_RUT_APODERADO=
BANCO_CHILE_TIMEOUT=35

# Banco de Chile - Produccion
# Cambie BANCO_CHILE_AMBIENTE a production y use la URL productiva entregada por BCH.
# La llave privada debe permanecer fuera del repositorio y fuera del directorio publico.
BANCO_CHILE_TOKEN_URL=https://apistore.bancochile.auth0app.com/oauth/token
BANCO_CHILE_PRIVATE_KEY_PATH=
BANCO_CHILE_PRIVATE_KEY_ID=
BANCO_CHILE_AUTH0_ASSERTION_AUDIENCE=https://apistore.bancochile.auth0app.com/
BANCO_CHILE_API_AUDIENCE=https://openbanking/

# Mercado Publico - solicite el ticket en https://www.chilecompra.cl/api/
MERCADO_PUBLICO_API_URL=https://api2.mercadopublico.cl
MERCADO_PUBLICO_TICKET=
MERCADO_PUBLICO_TIMEOUT=30
